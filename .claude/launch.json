{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "band-app",
      "runtimeExecutable": "node",
      "runtimeArgs": ["worker/dev.mjs", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "band-app-selftest",
      "runtimeExecutable": "node",
      "runtimeArgs": ["worker/dev.mjs", "--port", "8788", "--var", "SELFTEST:on"],
      "port": 8788
    },
    {
      "name": "band-app-do",
      "runtimeArgs": ["worker/dev.mjs", "--port", "8789",
                      "--var", "SELFTEST:on", "--var", "BACKEND:do"],
      "runtimeExecutable": "node",
      "port": 8789
    },
    {
      "name": "rider-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", ".", "-p", "8734", "-c-1"],
      "port": 8734
    }
  ]
}
